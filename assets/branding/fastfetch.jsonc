{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ordo/logo.txt",
    "padding": { "top": 1, "left": 2 },
    "color": { "1": "cyan", "2": "blue" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "blue" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "de",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
