#!/bin/sh
# ordo-migrate — 运行 config/migrations 中尚未执行的迁移
#
# 用法：
#   ordo migrate            执行全部待执行迁移
#   ordo migrate --pending  只列出待执行项，不执行
#   ordo migrate --all      忽略执行记录，全部重跑（迁移必须幂等才能这么用）
#
# 【为什么需要】install.sh 只解决「从零装」。已装机用户拿不到 config/ 的变更，
# 等于每次改进都只对「下一次重装」生效。本脚本是「增量」的那一半。
#
# 状态：/var/lib/ordo/migrations/<脚本名>.done —— 存在即视为已执行。
set -eu

_self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
_dir="$(dirname "$_self")"
. "$_dir/lib.sh"

ordo_require_tools mktemp rm cat date printf basename

STATE_DIR=/var/lib/ordo/migrations
DO_RUN=1
FORCE=0

for _arg in "$@"; do
    case "$_arg" in
        --pending) DO_RUN=0 ;;
        --all)     FORCE=1 ;;
        -h|--help)
            cat <<EOF
用法: ordo migrate [--pending|--all]

  （无参数）   执行全部待执行迁移
  --pending    只列出待执行项
  --all        忽略执行记录，全部重跑（要求迁移本身幂等）

迁移目录: $CONF_DIR/migrations
执行记录: $STATE_DIR
EOF
            exit "$ORDO_EXIT_OK"
            ;;
        *) ordo_bad "未知参数：$_arg"; exit "$ORDO_EXIT_BAD" ;;
    esac
done

MIG_DIR="$CONF_DIR/migrations"
if [ ! -d "$MIG_DIR" ]; then
    ordo_warn "没有迁移目录 $MIG_DIR（无需迁移）"
    exit "$ORDO_EXIT_OK"
fi

require_root "$(basename "$0") $*"

mkdir -p "$STATE_DIR"
chmod 755 "$STATE_DIR"

_pending=0
_failed=0
_ran=0

for _mig in "$MIG_DIR"/*.sh; do
    [ -f "$_mig" ] || continue
    _name="$(basename "$_mig")"
    _marker="$STATE_DIR/$_name.done"

    if [ "$FORCE" -eq 0 ] && [ -f "$_marker" ]; then
        continue
    fi

    _pending=$((_pending + 1))
    if [ "$DO_RUN" -eq 0 ]; then
        printf '  待执行: %s\n' "$_name"
        continue
    fi

    ordo_say "执行迁移 $_name"
    if /bin/sh "$_mig"; then
        # 记录时间戳而不是空文件：`ls -l` 就能看出什么时候跑的
        date -u '+%Y-%m-%dT%H:%M:%SZ' > "$_marker"
        chmod 644 "$_marker"
        _ran=$((_ran + 1))
        ordo_ok "$_name"
    else
        ordo_bad "$_name 失败 —— 已中止，后续迁移未执行"
        _failed=1
        break
    fi
done

echo
if [ "$DO_RUN" -eq 0 ]; then
    if [ "$_pending" -eq 0 ]; then
        ordo_ok "没有待执行的迁移"
        exit "$ORDO_EXIT_OK"
    fi
    printf '%d 项待执行（ordo migrate 执行）\n' "$_pending"
    exit "$ORDO_EXIT_OK"
fi

if [ "$_failed" -ne 0 ]; then
    printf '✘ 迁移中断（已执行 %d 项）\n' "$_ran"
    exit "$ORDO_EXIT_BAD"
fi

if [ "$_ran" -eq 0 ]; then
    ordo_ok "没有待执行的迁移"
else
    ordo_ok "完成：执行了 ${_ran} 项迁移"
fi
exit "$ORDO_EXIT_OK"
