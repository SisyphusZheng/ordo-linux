# Ordo uses the system login stack for user authentication.
#
# 密钥服务：auth 阶段把登录密码交给 pam_gnome_keyring，session 阶段启动守护进程
# 并用同一密码解锁/创建 login keyring —— 正常登录不弹「新建/解锁密钥环」。
auth            include         login
auth            optional        pam_gnome_keyring.so
account         include         login
password        include         login
session         include         login
session         optional        pam_gnome_keyring.so auto_start
